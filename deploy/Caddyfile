# Caddy kot obratni posrednik pred bb serve. Caddy sam pridobi in obnavlja HTTPS certifikat.
# Zamenjajte domeno, kopirajte v /etc/caddy/Caddyfile in: sudo systemctl reload caddy
kuhinja.example.si {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
